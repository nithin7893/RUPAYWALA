# Rupaywala backend environment template (names/placeholders only).
# Copy to .env for local development and fill values securely.
# NEVER commit real secrets.

# ------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
TESTING=false
EXPOSE_DOCS=true

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME

# ------------------------------------------------------------------
# Auth / security
# ------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
QUOTE_SIGNING_SECRET=replace-with-long-random-secret-at-least-32-chars
QUOTE_LEGACY_SIGNING_SECRET=

# ------------------------------------------------------------------
# CORS / host / HTTPS
# ------------------------------------------------------------------
# Comma-separated explicit origins. No wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated allowed hosts. Required in production.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Only enable when every request arrives through a proxy you control.
# Rate limiting and forwarded-proto handling honour forwarding headers ONLY
# when enabled AND the immediate peer IP is in this explicit allowlist.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1
HTTPS_REDIRECT_ENABLED=false
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
CONTENT_SECURITY_POLICY=default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# ------------------------------------------------------------------
# OTP / communications
# ------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_LOG=false

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Rupaywala
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

# ------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------------
# Payments (UPI - manual verification flow)
# ------------------------------------------------------------------
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=Rupaywala

# ------------------------------------------------------------------
# Maps
# ------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT=10.0
GOOGLE_MAPS_RETRY_LIMIT=2
GOOGLE_MAPS_GEOCODE_CACHE_TTL=86400
GOOGLE_MAPS_ROUTES_CACHE_TTL=600
GOOGLE_MAPS_PLACES_CACHE_TTL=86400

# ------------------------------------------------------------------
# Uploads / private document storage
# ------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# local | s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_SIGNED_URL_EXPIRES_SECONDS=300

# Malware scanning
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_PROVIDER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Document retention (days). 0 disables automatic expiry.
DOCUMENT_RETENTION_DAYS=0

# ------------------------------------------------------------------
# Pricing defaults (used only for initial seeding when table empty)
# ------------------------------------------------------------------
DEFAULT_DISTANCE_THRESHOLD_KM=10.0
DEFAULT_CHARGE_PER_KM=5.0
DEFAULT_TAX_PERCENT=18.0
DISTANCE_ROUND_TRIP_FACTOR=2.0
QUOTE_VALIDITY_MINUTES=15
